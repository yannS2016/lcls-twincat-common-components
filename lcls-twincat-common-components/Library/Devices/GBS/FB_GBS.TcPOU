<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_GBS" Id="{0c826496-bbe5-4d0f-95cc-b97d4fbafab2}" SpecialFunc="None">
    <Declaration><![CDATA[(* Grating Beam Splitter (GBS) with the library state enum E_GBS_States: FB_GBS_Core plus the
   enum bridge and the per-state defaults. FB_Init repeats the core inputs and
   binds the bridge. An FB that nests an FB_GBS calls CallAfterInitGBS
   from its own CallAfterInit. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_GBS EXTENDS FB_GBS_Core
VAR
    (* Device-specific state-enum bridge. Typed as E_GBS_States (UINT
       base); FB_Init binds it to the base's REFERENCE TO UINT
       bridge. EPICS owns it through the pytmc pragma; PLC code
       must go through the EnumSet property instead of touching it
       directly. *)
    // Set this to a non-unknown value to request a new move.
    {attribute 'pytmc' := '
        pv: MMS:STATE:SET
        io: io
    '}
    eEnumSet : E_GBS_States;

    (* One configurator per GBS state. Writes the
       per-state sName and fDelta once in its CallAfterInit, which this
       FB's CallAfterInit calls. *)
    afbStateDefaults : ARRAY[1..10] OF FB_CC_InternalStateConfig[
        (stPositionState := astPositionState[1][E_GBS_States.OUT],
         sName           := 'OUT',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_GBS_States.TARGET1a],
         sName           := 'TARGET1a',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_GBS_States.TARGET1b],
         sName           := 'TARGET1b',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_GBS_States.TARGET2a],
         sName           := 'TARGET2a',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_GBS_States.TARGET2b],
         sName           := 'TARGET2b',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_GBS_States.TARGET3a],
         sName           := 'TARGET3a',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_GBS_States.TARGET3b],
         sName           := 'TARGET3b',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_GBS_States.TARGET4],
         sName           := 'TARGET4',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_GBS_States.TARGET5],
         sName           := 'TARGET5',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_GBS_States.TARGET6],
         sName           := 'TARGET6',
         fDelta          := FDELTA_DEFAULT)
    ];
END_VAR
VAR_OUTPUT
    // The current position state as an enum.
    {attribute 'pytmc' := '
        pv: MMS:STATE:GET
        io: i
    '}
    eEnumGet: E_GBS_States;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Method Name="CallAfterInit" Id="{2f5a266d-a319-48e1-b797-55a7489c8359}">
      <Declaration><![CDATA[(* Auto-fired after FB_Init, together with the base CallAfterInit. Binds the
   state bridge to this FB's enum variables and initializes the states. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;

THIS^.InitStateDefaults();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallAfterInitGBS" Id="{8a40c3bc-e5b7-47ec-8c6d-2ba5964f68de}">
      <Declaration><![CDATA[(* Provides every FB_GBS_Core input, binds the state bridge, initializes the
   states through InitStateDefaults and wires fbStates. FB_Init calls it with the PRG arguments. An FB
   that instantiates FB_GBS inside itself calls it again from its own
   CallAfterInit: the nested FB's CallAfterInit runs before the host's, with
   nil references, so this method has to redo the whole wiring, base included.
   The base holds only references, so the derived type supplies them. *)
METHOD CallAfterInitGBS
VAR_INPUT
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.aiMotionStage         REF= aiMotionStage;
SUPER^.astPositionState      REF= astPositionState;
SUPER^.fbFFHWO               REF= fbFFHWO;
SUPER^.fbArbiter             REF= fbArbiter;
SUPER^.sDeviceName           := sDeviceName;
SUPER^.sTransitionKey        := sTransitionKey;
SUPER^.bEnableBeamParams     := bEnableBeamParams;
SUPER^.bEnablePositionLimits := bEnablePositionLimits;
SUPER^.bReadDBNow            := bReadDBNow;
SUPER^.bFileReaderBusy       REF= bFileReaderBusy;
SUPER^.bFileReaderError      REF= bFileReaderError;

SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;
// 
THIS^.InitStateDefaults();
SUPER^.CallAfterInitCore();
]]></ST>
      </Implementation>
    </Method>
    <Property Name="EnumGet" Id="{61992fb1-3b6c-41d7-96d4-f00c9bd1ceca}">
      <Declaration><![CDATA[(* Current position state. Read-only; written by the state mover. *)
PROPERTY EnumGet : E_GBS_States]]></Declaration>
      <Get Name="Get" Id="{625855fb-06ae-447c-a3c6-d3f531962246}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumGet := eEnumGet;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EnumSet" Id="{84177839-97a2-4864-bf5b-d970f06b7ea0}">
      <Declaration><![CDATA[(* Request a new move, e.g. `fbGBS.EnumSet := E_GBS_States.TARGET1a;`.
   The state mover consumes and clears the request. *)
PROPERTY EnumSet : E_GBS_States]]></Declaration>
      <Get Name="Get" Id="{c84fd02c-fce1-4457-ade2-a2d1adc1e7c3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumSet := eEnumSet;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{d868efc9-33a4-4fe2-8a6d-dc99b8089596}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eEnumSet := EnumSet;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>