<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_SLITSPOWERInit" Id="{bb85fbbd-dd03-4481-82f6-82cf1cfc48e8}" SpecialFunc="None">
    <Declaration><![CDATA[(* Production-style program with a FB_SLITS_POWER nested in FB_SLITSPOWERInitHost. It follows
   PRG_ATMInit: the motor stages, the configurators where the device has them,
   and the host. The arbiter, fast-fault output, persistent storage and DB
   reader are shared in GVL_PRG and ticked by PRG_PMPS_PRE and PRG_PMPS_POST. The RTD limits come from TST:POWER in
   plc-cc-motion.json. *)
PROGRAM PRG_SLITSPOWERInit
VAR
	{attribute 'TcNcAxis' := 'PRG_SLITSPOWER_Top'}
    axTop : AXIS_REF;
	{attribute 'TcNcAxis' := 'PRG_SLITSPOWER_Bottom'}
    axBottom : AXIS_REF;
	{attribute 'TcNcAxis' := 'PRG_SLITSPOWER_North'}
    axNorth : AXIS_REF;
	{attribute 'TcNcAxis' := 'PRG_SLITSPOWER_South'}
    axSouth : AXIS_REF;

    afbMotor : ARRAY[1..4] OF FB_MotionStageNC[
        (AxisRef := axTop,    iPersistentDataStorage := GVL_PRG.fbPDS, sName := 'SLITSPOWERTop'),
        (AxisRef := axBottom, iPersistentDataStorage := GVL_PRG.fbPDS, sName := 'SLITSPOWERBottom'),
        (AxisRef := axNorth,  iPersistentDataStorage := GVL_PRG.fbPDS, sName := 'SLITSPOWERNorth'),
        (AxisRef := axSouth,  iPersistentDataStorage := GVL_PRG.fbPDS, sName := 'SLITSPOWERSouth')
    ];
    aiMotionStage : ARRAY[1..4] OF I_MotionStage := [
        afbMotor[E_SlitsBlade.TOP],
        afbMotor[E_SlitsBlade.BOTTOM],
        afbMotor[E_SlitsBlade.NORTH],
        afbMotor[E_SlitsBlade.SOUTH]
    ];

    fbHost : FB_SLITSPOWERInitHost(
        aiMotionStage   := aiMotionStage,
        fbFFHWO         := GVL_PRG.fbFastFaultOutput1,
        sDeviceName     := 'TST:POWER',
        sPmpsState      := 'TST:POWER-RTD',
        bFileReaderBusy := MOTION_GVL.fbPmpsFileReader.bBusy,
        fApertureMargin := 0.01
    );

    i          : UINT;
    bFirstScan : BOOL := TRUE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bFirstScan THEN
    FOR i := 1 TO 4 DO
        afbMotor[i].SetModeEnableLimits(
            LimBackward    := TRUE,
            LimForward     := TRUE,
            HomeEnable     := FALSE,
            BrakeMode      := E_StageBrakeMode.NO_BRAKE,
            EnableMode     := E_StageEnableMode.DURING_MOTION,
            HomeMode       := E_EpicsHomeCmd.NONE,
            UserEnable     := TRUE,
            HardwareEnable := TRUE
        );
        afbMotor[i].SetVelocity(
            Velocity := 15.5
        );
        afbMotor[i].RestoreMotionParams      := FALSE;
        afbMotor[i].DoNotRestoreNcParameters := TRUE;
    END_FOR
    bFirstScan := FALSE;
END_IF

fbHost();

FOR i := 1 TO 4 DO
    afbMotor[i]();
END_FOR
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
