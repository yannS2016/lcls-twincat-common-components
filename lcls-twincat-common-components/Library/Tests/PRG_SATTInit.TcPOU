<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_SATTInit" Id="{ee426bc6-d318-4803-8454-6993306e29d0}" SpecialFunc="None">
    <Declaration><![CDATA[(* Production-style program with a FB_SXR_SATT_Stage nested in FB_SATTInitHost. It follows
   PRG_ATMInit: the motor stages, the configurators where the device has them,
   and the host. The arbiter, fast-fault output, persistent storage and DB
   reader are shared in GVL_PRG and ticked by PRG_PMPS_PRE and PRG_PMPS_POST. The filter configurators write through the host,
   which implements I_SATTFilters. The RTD reactive temperature comes from
   AT1K4:L2SI-RTD in plc-cc-motion.json. *)
PROGRAM PRG_SATTInit
VAR
	{attribute 'TcNcAxis' := 'PRG_SATT_Y'}
    axRef         : AXIS_REF;
    fbMotor       : FB_MotionStageNC(
        AxisRef                := axRef,
        iPersistentDataStorage := GVL_PRG.fbPDS,
        sName                  := 'SATTINIT'
    );
    aiMotionStage : ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage := [fbMotor];

    astPositionState : ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                         OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;

    fbHost : FB_SATTInitHost(
        aiMotionStage    := aiMotionStage,
        astPositionState := astPositionState,
        bFileReaderBusy  := MOTION_GVL.fbPmpsFileReader.bBusy,
        fbFFHWO          := GVL_PRG.fbFastFaultOutput1,
        sDeviceName      := 'AT1K4:L2SI',
        RTDPMPSState     := 'AT1K4:L2SI-RTD'
    );

    stDefault : ST_PositionState := (
        fDelta        := 0.2,
        bMoveOk       := TRUE,
        bValid        := TRUE,
        bUseRawCounts := FALSE
    );
    afbStateDefaults : ARRAY[1..9] OF FB_CC_StateDefaultsConfig[
        (stPositionState := astPositionState[1][E_SXR_SATT_Position.OUT],     stDefault := stDefault, sName := 'Out',     fPosition := 10),
        (stPositionState := astPositionState[1][E_SXR_SATT_Position.FILTER1], stDefault := stDefault, sName := 'Filter1', fPosition := 20),
        (stPositionState := astPositionState[1][E_SXR_SATT_Position.FILTER2], stDefault := stDefault, sName := 'Filter2', fPosition := 30),
        (stPositionState := astPositionState[1][E_SXR_SATT_Position.FILTER3], stDefault := stDefault, sName := 'Filter3', fPosition := 40),
        (stPositionState := astPositionState[1][E_SXR_SATT_Position.FILTER4], stDefault := stDefault, sName := 'Filter4', fPosition := 50),
        (stPositionState := astPositionState[1][E_SXR_SATT_Position.FILTER5], stDefault := stDefault, sName := 'Filter5', fPosition := 60),
        (stPositionState := astPositionState[1][E_SXR_SATT_Position.FILTER6], stDefault := stDefault, sName := 'Filter6', fPosition := 70),
        (stPositionState := astPositionState[1][E_SXR_SATT_Position.FILTER7], stDefault := stDefault, sName := 'Filter7', fPosition := 80),
        (stPositionState := astPositionState[1][E_SXR_SATT_Position.FILTER8], stDefault := stDefault, sName := 'Filter8', fPosition := 90)
    ];

    // Filter material and thickness, written into the stage through the host's I_SATTFilters.
    afbFilterCfg : ARRAY[1..8] OF FB_SATT_FilterConfig[
        (iFilters := fbHost, nIndex := 1, sFilterMaterial := 'C',  fFilterThickness_um := 25),
        (iFilters := fbHost, nIndex := 2, sFilterMaterial := 'C',  fFilterThickness_um := 50),
        (iFilters := fbHost, nIndex := 3, sFilterMaterial := 'C',  fFilterThickness_um := 100),
        (iFilters := fbHost, nIndex := 4, sFilterMaterial := 'Si', fFilterThickness_um := 200),
        (iFilters := fbHost, nIndex := 5, sFilterMaterial := 'Si', fFilterThickness_um := 320),
        (iFilters := fbHost, nIndex := 6, sFilterMaterial := 'Si', fFilterThickness_um := 640),
        (iFilters := fbHost, nIndex := 7, sFilterMaterial := 'Si', fFilterThickness_um := 1280),
        (iFilters := fbHost, nIndex := 8, sFilterMaterial := 'Si', fFilterThickness_um := 2560)
    ];

    i          : UINT;
    bFirstScan : BOOL := TRUE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bFirstScan THEN
    fbMotor.SetModeEnableLimits(
        LimBackward    := TRUE,
        LimForward     := TRUE,
        HomeEnable     := FALSE,
        BrakeMode      := E_StageBrakeMode.NO_BRAKE,
        EnableMode     := E_StageEnableMode.DURING_MOTION,
        HomeMode       := E_EpicsHomeCmd.NONE,
        UserEnable     := TRUE,
        HardwareEnable := TRUE
    );
    fbMotor.SetVelocity(
        Velocity := 15.5
    );
    fbMotor.RestoreMotionParams      := FALSE;
    fbMotor.DoNotRestoreNcParameters := TRUE;
    bFirstScan := FALSE;
END_IF

FOR i := 1 TO 9 DO
    afbStateDefaults[i]();
END_FOR

fbHost();
fbMotor();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
