<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ATM" Id="{2f5a266c-a319-48e1-b797-55a7489c8358}" SpecialFunc="None">
    <Declaration><![CDATA[(* Arrival Time Monitor with the library state enum E_ATM_States (OUT,
   TARGET1..TARGET5): FB_ATM_Generic with the enum bridge owned here. The
   MMS:STATE:SET and MMS:STATE:GET PVs and the state names are the same as
   before. A device with a different state list uses FB_ATM_Generic directly
   with its own enum. FB_Init is inherited, so the caller injects the same
   references as for FB_ATM_Generic and leaves the bridge arguments out. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_ATM EXTENDS FB_ATM_Generic
VAR
    (* Device-specific state-enum bridge. Typed as E_ATM_States (UINT
       base); CallAfterInit binds it to the base's REFERENCE TO UINT
       bridge. EPICS owns it through the pytmc pragma; PLC code
       must go through the EnumSet property instead of touching it
       directly. *)
    // Set this to a non-unknown value to request a new move.
    {attribute 'pytmc' := '
        pv: MMS:STATE:SET
        io: io
    '}
    eEnumSet : E_ATM_States;
END_VAR
VAR_OUTPUT
    // The current position state as an enum.
    {attribute 'pytmc' := '
        pv: MMS:STATE:GET
        io: i
    '}
    eEnumGet: E_ATM_States;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Method Name="CallAfterInit" Id="{2f5a266d-a319-48e1-b797-55a7489c8359}">
      <Declaration><![CDATA[(* Auto-fired after FB_Init. Binds the base's UINT state bridge to
   eEnumSet and eEnumGet, then runs the base CallAfterInit, which writes the
   state names and wires fbStates. The bridge goes through UINT pointers
   because the base references are typed UINT. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
VAR
    pEnumSet : POINTER TO UINT;
    pEnumGet : POINTER TO UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pEnumSet := ADR(THIS^.eEnumSet);
pEnumGet := ADR(THIS^.eEnumGet);
THIS^.eEnumSetRef REF= pEnumSet^;
THIS^.eEnumGetRef REF= pEnumGet^;

IF THIS^.nStateCount = 0 THEN
    THIS^.nStateCount := nDefaultStateCount;
END_IF

SUPER^.CallAfterInit();
]]></ST>
      </Implementation>
    </Method>
    <Property Name="EnumGet" Id="{15313ef5-dd3a-44f9-a68a-27060a7cd2ff}">
      <Declaration><![CDATA[(* Current position state. Read-only; written by the state mover. *)
PROPERTY EnumGet : E_ATM_States]]></Declaration>
      <Get Name="Get" Id="{f0b1821b-d1dc-41ec-9f21-f65079e6a42a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumGet := eEnumGet;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EnumSet" Id="{d6867564-423e-4de5-8672-3b648d7df078}">
      <Declaration><![CDATA[(* Request a new move, e.g. `fbATM.EnumSet := E_ATM_States.TARGET1;`.
   The state mover consumes and clears the request. *)
PROPERTY EnumSet : E_ATM_States]]></Declaration>
      <Get Name="Get" Id="{9fcfe38e-096e-4ba8-8d70-7fd16ad47420}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumSet := eEnumSet;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{bcf7d591-82dd-413a-95e8-044611b7da05}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eEnumSet := EnumSet;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>