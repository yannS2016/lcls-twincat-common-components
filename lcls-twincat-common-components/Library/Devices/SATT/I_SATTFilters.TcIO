<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="I_SATTFilters" Id="{f9838904-a52b-4dda-8168-caa566d79ee3}">
    <Declaration><![CDATA[(* Write access to the filter table of a solid attenuator stage. FB_SATT_FilterConfig
   holds this interface and fills one slot of the table from its CallAfterInit,
   so the table needs no public member. *)
INTERFACE I_SATTFilters
]]></Declaration>
    <Method Name="SetFilter" Id="{25a4b4f5-a538-42a2-bc53-b28a6cbb6b41}">
      <Declaration><![CDATA[(* Sets the material and thickness of one filter. Index 1 is FILTER1. An index
   outside 1..8 is ignored. *)
METHOD SetFilter
VAR_INPUT
    Index         : UINT;
    Material      : STRING;
    Thickness_um  : LREAL;
END_VAR
]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
