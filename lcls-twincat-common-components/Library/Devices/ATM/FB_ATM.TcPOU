<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ATM" Id="{2f5a266c-a319-48e1-b797-55a7489c8358}" SpecialFunc="None">
    <Declaration><![CDATA[(* Arrival Time Monitor with the library state enum E_ATM_States (OUT,
   TARGET1..TARGET5): FB_ATM_Core plus the enum bridge and the per-state
   defaults. FB_Init repeats the core inputs and binds the bridge. A device
   with another state list derives FB_ATM_Core the same way. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_ATM EXTENDS FB_ATM_Core
VAR
    (* Device-specific state-enum bridge. Typed as E_ATM_States (UINT
       base); FB_Init binds it to the base's REFERENCE TO UINT
       bridge. EPICS owns it through the pytmc pragma; PLC code
       must go through the EnumSet property instead of touching it
       directly. *)
    // Set this to a non-unknown value to request a new move.
    {attribute 'pytmc' := '
        pv: MMS:STATE:SET
        io: io
    '}
    eEnumSet : E_ATM_States;

    (* One configurator per ATM state (OUT + 5 targets). Writes the
       per-state sName and fDelta once in its CallAfterInit, which this
       FB's CallAfterInit calls. *)
    afbStateDefaults : ARRAY[1..6] OF FB_CC_InternalStateConfig[
        (stPositionState := astPositionState[1][E_ATM_States.OUT],
         sName           := 'OUT',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_ATM_States.TARGET1],
         sName           := 'TARGET1',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_ATM_States.TARGET2],
         sName           := 'TARGET2',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_ATM_States.TARGET3],
         sName           := 'TARGET3',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_ATM_States.TARGET4],
         sName           := 'TARGET4',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_ATM_States.TARGET5],
         sName           := 'TARGET5',
         fDelta          := FDELTA_DEFAULT)
    ];
END_VAR
VAR_OUTPUT
    // The current position state as an enum.
    {attribute 'pytmc' := '
        pv: MMS:STATE:GET
        io: i
    '}
    eEnumGet: E_ATM_States;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{4d59ebc2-c21f-4355-9b6d-75854f0da2d1}">
      <Declaration><![CDATA[(* Repeats the eleven FB_ATM_Core inputs, as a derived FB_Init must, and binds
   the base state bridge to this FB's own enum variables. Runs before any
   CallAfterInit, so the base wires fbStates with a valid bridge. *)
{attribute 'analysis' := '-33'}
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains           : BOOL;
    bInCopyCode            : BOOL;
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallAfterInit" Id="{2f5a266d-a319-48e1-b797-55a7489c8359}">
      <Declaration><![CDATA[(* Auto-fired after FB_Init, together with the base CallAfterInit. Binds the
   state bridge again, because every base member is a reference and this FB may
   be instantiated inside another FB, where the FB_Init binding can happen
   before the enclosing FB's own storage is valid. Then writes the per-state
   sName and fDelta through the configurators, which need the slot references
   bound by now. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.eEnumSetRef REF= THIS^.eEnumSet;
SUPER^.eEnumGetRef REF= THIS^.eEnumGet;

afbStateDefaults[1].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_ATM_States.OUT]
);
afbStateDefaults[2].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_ATM_States.TARGET1]
);
afbStateDefaults[3].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_ATM_States.TARGET2]
);
afbStateDefaults[4].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_ATM_States.TARGET3]
);
afbStateDefaults[5].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_ATM_States.TARGET4]
);
afbStateDefaults[6].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_ATM_States.TARGET5]
);
]]></ST>
      </Implementation>
    </Method>
    <Property Name="EnumGet" Id="{15313ef5-dd3a-44f9-a68a-27060a7cd2ff}">
      <Declaration><![CDATA[(* Current position state. Read-only; written by the state mover. *)
PROPERTY EnumGet : E_ATM_States]]></Declaration>
      <Get Name="Get" Id="{f0b1821b-d1dc-41ec-9f21-f65079e6a42a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumGet := eEnumGet;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EnumSet" Id="{d6867564-423e-4de5-8672-3b648d7df078}">
      <Declaration><![CDATA[(* Request a new move, e.g. `fbATM.EnumSet := E_ATM_States.TARGET1;`.
   The state mover consumes and clears the request. *)
PROPERTY EnumSet : E_ATM_States]]></Declaration>
      <Get Name="Get" Id="{9fcfe38e-096e-4ba8-8d70-7fd16ad47420}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnumSet := eEnumSet;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{bcf7d591-82dd-413a-95e8-044611b7da05}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eEnumSet := EnumSet;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>