<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ATM" Id="{2f5a266c-a319-48e1-b797-55a7489c8358}" SpecialFunc="None">
    <Declaration><![CDATA[(* Arrival Time Monitor with the library state list OUT, TARGET1..TARGET5:
   FB_ATM_Core plus the per-state defaults. The caller owns the enum variables
   (E_ATM_States, with the MMS:STATE:SET and MMS:STATE:GET pytmc pragmas) and
   passes them to FB_Init, which FB_ATM_Core assigns. A device with another
   state list derives FB_ATM_Core the same way. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_ATM EXTENDS FB_ATM_Core
VAR
    (* One configurator per ATM state (OUT + 5 targets). Writes the
       per-state sName and fDelta once in its CallAfterInit, which this
       FB's CallAfterInit calls. *)
    afbStateDefaults : ARRAY[1..6] OF FB_CC_InternalStateConfig[
        (stPositionState := astPositionState[1][E_ATM_States.OUT],
         sName           := 'OUT',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_ATM_States.TARGET1],
         sName           := 'TARGET1',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_ATM_States.TARGET2],
         sName           := 'TARGET2',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_ATM_States.TARGET3],
         sName           := 'TARGET3',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_ATM_States.TARGET4],
         sName           := 'TARGET4',
         fDelta          := FDELTA_DEFAULT),
        (stPositionState := astPositionState[1][E_ATM_States.TARGET5],
         sName           := 'TARGET5',
         fDelta          := FDELTA_DEFAULT)
    ];
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Method Name="CallAfterInit" Id="{2f5a266d-a319-48e1-b797-55a7489c8359}">
      <Declaration><![CDATA[(* Auto-fired after FB_Init, together with the base CallAfterInit. Writes the
   per-state sName and fDelta through the configurators, which need the slot
   references that FB_Init has bound by now. *)
{attribute 'call_after_init'}
METHOD CallAfterInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[afbStateDefaults[1].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_ATM_States.OUT]
);
afbStateDefaults[2].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_ATM_States.TARGET1]
);
afbStateDefaults[3].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_ATM_States.TARGET2]
);
afbStateDefaults[4].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_ATM_States.TARGET3]
);
afbStateDefaults[5].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_ATM_States.TARGET4]
);
afbStateDefaults[6].CallAfterInit(
    stPositionState := THIS^.astPositionState[1][E_ATM_States.TARGET5]
);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>