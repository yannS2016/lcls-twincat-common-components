<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ATMInitTest" Id="{257f0a2b-ea54-44f1-87bc-30e5966c1756}" SpecialFunc="None">
    <Declaration><![CDATA[(* Checks that an FB_ATM leaves every state of its position array named and with
   the default tolerance, in the two ways it can be instantiated: directly in a
   PROGRAM (PRG_ATMInit.fbATM) and nested inside another FB, where the
   references it was constructed with are still nil (PRG_ATMInit.fbHost).
   Reads the results of initialization; nothing is ticked. *)
FUNCTION_BLOCK FB_ATMInitTest EXTENDS FB_TestSuite
VAR
END_VAR
VAR CONSTANT
    // States of FB_ATM: OUT and TARGET1..TARGET5.
    nStateCount : UINT := 6;
    // FB_ATM_Core.FDELTA_DEFAULT.
    fDeltaExpected : LREAL := 2;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[TestPrgInstance();
TestNestedInstance();
]]></ST>
    </Implementation>
    <Method Name="CheckStates" Id="{4ffbb3c5-4682-4eb1-84d8-9649b9225faf}">
      <Declaration><![CDATA[(* Asserts the name and tolerance of states 1..nStateCount of the array. *)
METHOD CheckStates
VAR_INPUT
    astCheck : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                              OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    sCase    : STRING;
END_VAR
VAR
    nState     : UINT;
    sExpected  : STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR nState := 1 TO nStateCount DO
    IF nState = 1 THEN
        sExpected := 'OUT';
    ELSE
        sExpected := CONCAT('TARGET', UINT_TO_STRING(nState - 1));
    END_IF
    AssertEquals_STRING(
        Expected := sExpected,
        Actual   := astCheck[1][nState].sName,
        Message  := CONCAT(sCase, CONCAT(': name of state ', UINT_TO_STRING(nState))));
    AssertTrue(
        ABS(astCheck[1][nState].fDelta - fDeltaExpected) < 0.001,
        CONCAT(sCase, CONCAT(': tolerance of state ', UINT_TO_STRING(nState))));
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestPrgInstance" Id="{844d719e-2f11-437e-9163-735e4618c507}">
      <Declaration><![CDATA[(* FB_ATM declared in a PROGRAM. *)
METHOD TestPrgInstance
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestATMInitFromPrg');

CheckStates(
    astCheck := PRG_ATMInit.astPositionStatePrg,
    sCase    := 'FB_ATM in a PRG'
);

TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestNestedInstance" Id="{61789a2f-682c-451a-a897-074433c008c1}">
      <Declaration><![CDATA[(* FB_ATM nested in FB_ATMInitHost, which re-wires it in its CallAfterInit. *)
METHOD TestNestedInstance
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestATMInitNested');

CheckStates(
    astCheck := PRG_ATMInit.astPositionStateNested,
    sCase    := 'FB_ATM nested in an FB'
);

TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
