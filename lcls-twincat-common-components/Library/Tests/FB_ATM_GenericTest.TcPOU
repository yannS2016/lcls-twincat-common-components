<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ATM_GenericTest" Id="{70d9025c-8da3-4d00-89cf-62b673c94556}" SpecialFunc="None">
    <Declaration><![CDATA[(* Tests FB_ATM_Generic with a caller-owned enum of nine states (OUT plus
   eight targets), caller-supplied state names and an external UINT bridge.
   A second instance with nStateCount 0 checks the six-state fallback. The
   nine-state test needs GeneralConstants.MAX_STATES of at least 9. *)
FUNCTION_BLOCK FB_ATM_GenericTest EXTENDS FB_TestSuite
VAR
    axRef    : ARRAY[1..2] OF AXIS_REF;
    fbPDS    : LCLS_Tc_DevAbs.FB_PersistentDataStorage;
    fbMotorX : FB_MotionStageNC(AxisRef := axRef[1], iPersistentDataStorage := fbPDS, sName := 'X');
    fbMotorY : FB_MotionStageNC(AxisRef := axRef[2], iPersistentDataStorage := fbPDS, sName := 'Y');
    aiMotionStage : ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage := [fbMotorY];

    {attribute 'pytmc' := '
        pv: MMS
        array: 1..1 | 1..9
    '}
    astPositionState : ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                         OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    // Second instance, which has no moves requested. It only checks the default count.
    astPositionStateSix : ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                         OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;

    fbFFHWO    : FB_HardwareFFOutput;
    fbArbiter  : FB_Arbiter(1);
    fbSubSysIO : FB_DummyArbIO;

    sDeviceName    : STRING := 'TST:ATMG';
    sTransitionKey : STRING := 'TST:ATMG-TRANSITION';
    bFileReaderBusy  : BOOL;
    bFileReaderError : BOOL;

    // Caller-owned state bridge of the nine-state instance.
    eEnumSet : E_ATMGenericTestStates;
    eEnumGet : E_ATMGenericTestStates;
    // Caller-owned state bridge of the default-count instance.
    eEnumSetSix : E_ATMGenericTestStates;
    eEnumGetSix : E_ATMGenericTestStates;

    // Index 5 is blank on purpose, so it falls back to TARGET4.
    asStateName : ARRAY[1..GeneralConstants.MAX_STATES] OF STRING :=
        ['OUT', 'GaAs', 'InGaAs', 'gITO', '', 'YAG', 'DIODE', 'SPARE7', 'SPARE8'];

    fbATM : FB_ATM_Generic(
        aiMotionStage         := aiMotionStage,
        astPositionState      := astPositionState,
        fbFFHWO               := fbFFHWO,
        fbArbiter             := fbArbiter,
        sDeviceName           := sDeviceName,
        sTransitionKey        := sTransitionKey,
        bEnableBeamParams     := TRUE,
        bEnablePositionLimits := TRUE,
        bReadDBNow            := TRUE,
        bFileReaderBusy       := bFileReaderBusy,
        bFileReaderError      := bFileReaderError,
        eEnumSetRef           := eEnumSet,
        eEnumGetRef           := eEnumGet,
        nStateCount           := 9,
        asStateName           := asStateName
    );

    // All blank, so every state of the default-count instance uses its default name.
    asStateNameSix : ARRAY[1..GeneralConstants.MAX_STATES] OF STRING;

    fbATMSix : FB_ATM_Generic(
        aiMotionStage         := aiMotionStage,
        astPositionState      := astPositionStateSix,
        fbFFHWO               := fbFFHWO,
        fbArbiter             := fbArbiter,
        sDeviceName           := 'TST:ATMG6',
        sTransitionKey        := 'TST:ATMG6-TRANSITION',
        bEnableBeamParams     := FALSE,
        bEnablePositionLimits := FALSE,
        bReadDBNow            := FALSE,
        bFileReaderBusy       := bFileReaderBusy,
        bFileReaderError      := bFileReaderError,
        eEnumSetRef           := eEnumSetSix,
        eEnumGetRef           := eEnumGetSix,
        nStateCount           := 0,
        asStateName           := asStateNameSix
    );

    stDefault : ST_PositionState := (
        bMoveOk       := TRUE,
        bValid        := TRUE,
        bUseRawCounts := FALSE
    );

    afbStatePMPS : ARRAY[1..9] OF FB_CC_StatePMPSConfig[
        (stPositionState := astPositionState[1][E_ATMGenericTestStates.OUT],
         stDefault       := stDefault,
         fPosition       := 10,
         sPmpsState      := 'TST:ATMG-OUT'),
        (stPositionState := astPositionState[1][E_ATMGenericTestStates.TARGET1],
         stDefault       := stDefault,
         fPosition       := 20,
         sPmpsState      := 'TST:ATMG-TARGET1'),
        (stPositionState := astPositionState[1][E_ATMGenericTestStates.TARGET2],
         stDefault       := stDefault,
         fPosition       := 30,
         sPmpsState      := 'TST:ATMG-TARGET2'),
        (stPositionState := astPositionState[1][E_ATMGenericTestStates.TARGET3],
         stDefault       := stDefault,
         fPosition       := 40,
         sPmpsState      := 'TST:ATMG-TARGET3'),
        (stPositionState := astPositionState[1][E_ATMGenericTestStates.TARGET4],
         stDefault       := stDefault,
         fPosition       := 50,
         sPmpsState      := 'TST:ATMG-TARGET4'),
        (stPositionState := astPositionState[1][E_ATMGenericTestStates.TARGET5],
         stDefault       := stDefault,
         fPosition       := 60,
         sPmpsState      := 'TST:ATMG-TARGET5'),
        (stPositionState := astPositionState[1][E_ATMGenericTestStates.TARGET6],
         stDefault       := stDefault,
         fPosition       := 70,
         sPmpsState      := 'TST:ATMG-TARGET6'),
        (stPositionState := astPositionState[1][E_ATMGenericTestStates.TARGET7],
         stDefault       := stDefault,
         fPosition       := 80,
         sPmpsState      := 'TST:ATMG-TARGET7'),
        (stPositionState := astPositionState[1][E_ATMGenericTestStates.TARGET8],
         stDefault       := stDefault,
         fPosition       := 90,
         sPmpsState      := 'TST:ATMG-TARGET8')
    ];

    bFirstScan : BOOL := TRUE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bFirstScan THEN
    fbMotorY.SetModeEnableLimits(
        LimBackward    := TRUE,
        LimForward     := TRUE,
        HomeEnable     := FALSE,
        BrakeMode      := E_StageBrakeMode.IF_ENABLED,
        EnableMode     := E_StageEnableMode.DURING_MOTION,
        HomeMode       := E_EpicsHomeCmd.LOW_LIMIT,
        UserEnable     := TRUE,
        HardwareEnable := TRUE
    );
    fbMotorX.SetModeEnableLimits(
        LimBackward    := TRUE,
        LimForward     := TRUE,
        HomeEnable     := FALSE,
        BrakeMode      := E_StageBrakeMode.IF_ENABLED,
        EnableMode     := E_StageEnableMode.DURING_MOTION,
        HomeMode       := E_EpicsHomeCmd.LOW_LIMIT,
        UserEnable     := TRUE,
        HardwareEnable := TRUE
    );
    fbMotorX.SetVelocity(Velocity := 15.5);
    fbMotorX.RestoreMotionParams      := FALSE;
    fbMotorX.DoNotRestoreNcParameters := TRUE;
    fbMotorY.SetVelocity(Velocity := 15.5);
    fbMotorY.RestoreMotionParams      := FALSE;
    fbMotorY.DoNotRestoreNcParameters := TRUE;
    bFileReaderBusy  := TRUE;
    bFileReaderError := FALSE;
    bFirstScan := FALSE;
END_IF

TestStateNames();
TestDefaultStateCount();
TestStateMove();
TestTempFFO();

fbSubSysIO(
    LA  := fbArbiter,
    FFO := fbFFHWO
);
fbPDS();
fbMotorX();
fbMotorY();
fbATM();
fbATMSix();

bFileReaderBusy  := FALSE;
bFileReaderError := FALSE;
]]></ST>
    </Implementation>
    <Method Name="SetATMTemp" Id="{9a0b5dfb-d7f9-497e-8afc-c77d4eb16b1a}">
      <Declaration><![CDATA[METHOD SetATMTemp
VAR_INPUT
    iTempC : INT;
END_VAR
VAR
    ptr : POINTER TO INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ptr  := ADR(fbATM.fbTempSensor1.iRaw);
ptr^ := iTempC * 10;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestDefaultStateCount" Id="{43a7481f-b876-4fd5-beb8-584f932eda4d}">
      <Declaration><![CDATA[(* An instance built with nStateCount 0 resolves to six states. It names
   OUT and TARGET1..TARGET5 and leaves state 7 alone. *)
METHOD TestDefaultStateCount
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestATMGenericDefaultStateCount');

AssertEquals_UINT(
    Expected := 6,
    Actual   := fbATMSix.nStateCount,
    Message  := 'nStateCount 0 should resolve to 6');
AssertEquals_STRING(
    Expected := 'OUT',
    Actual   := astPositionStateSix[1][1].sName,
    Message  := 'Default name of state 1');
AssertEquals_STRING(
    Expected := 'TARGET5',
    Actual   := astPositionStateSix[1][6].sName,
    Message  := 'Default name of state 6');
AssertEquals_STRING(
    Expected := '',
    Actual   := astPositionStateSix[1][7].sName,
    Message  := 'State 7 is outside the default count and keeps no name');

TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestStateMove" Id="{38a8d0c0-09a0-4b71-b0cd-2049a33afea7}">
      <Declaration><![CDATA[(* Walks OUT then TARGET8, the highest state of the nine-state enum, and
   asserts each lands within fTolerance of its configured fPosition. *)
METHOD TestStateMove
VAR_INST
    tonTimer  : TON;
    nTestStep : INT := 0;
    fObserved : LREAL;
END_VAR
VAR CONSTANT
    fTolerance : LREAL := 2.0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestATMGenericStateMove');

tonTimer(IN := TRUE, PT := T#60s);
fObserved := fbMotorY.stMotionStatus.fActPosition;

CASE nTestStep OF
    0:
        IF fbMotorY.stMotionStatus.bStageReady
           AND NOT fbMotorY.stMotionStatus.bError THEN
            eEnumSet  := E_ATMGenericTestStates.OUT;
            nTestStep := 1;
        END_IF
    1:
        (* OUT is configured at fPosition := 10. *)
        IF eEnumGet = E_ATMGenericTestStates.OUT
           AND NOT fbMotorY.stMotionStatus.bMoving
           AND ABS(fObserved - 10.0) <= fTolerance THEN
            eEnumSet  := E_ATMGenericTestStates.TARGET8;
            nTestStep := 2;
        END_IF
    2:
        (* TARGET8 is configured at fPosition := 90. *)
        IF eEnumGet = E_ATMGenericTestStates.TARGET8
           AND NOT fbMotorY.stMotionStatus.bMoving
           AND ABS(fObserved - 90.0) <= fTolerance THEN
            AssertTrue(
                Condition := TRUE,
                Message   := 'TestATMGenericStateMove: OUT then TARGET8 reached within tolerance');
            nTestStep := 3;
        END_IF
END_CASE

IF nTestStep = 3 THEN
    TEST_FINISHED();
ELSIF tonTimer.Q THEN
    AssertTrue(
        Condition := FALSE,
        Message   := CONCAT(
            CONCAT(
                CONCAT('TestATMGenericStateMove: timed out at step ', TO_STRING(nTestStep)),
                CONCAT(', eEnumGet=', TO_STRING(TO_UDINT(eEnumGet)))),
            CONCAT(', fActPos=', TO_STRING(fObserved))));
    TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestStateNames" Id="{f6df5267-bfdc-46a9-8c67-b1e3b9d1109f}">
      <Declaration><![CDATA[(* The caller-supplied names reach the state slots. The blank entry for state 5
   falls back to TARGET4, and state 9 (the highest) is named. *)
METHOD TestStateNames
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestATMGenericStateNames');

AssertEquals_UINT(
    Expected := 9,
    Actual   := fbATM.nStateCount,
    Message  := 'nStateCount should be 9');
AssertEquals_STRING(
    Expected := 'OUT',
    Actual   := astPositionState[1][1].sName,
    Message  := 'Name of state 1');
AssertEquals_STRING(
    Expected := 'GaAs',
    Actual   := astPositionState[1][2].sName,
    Message  := 'Caller-supplied name of state 2');
AssertEquals_STRING(
    Expected := 'TARGET4',
    Actual   := astPositionState[1][5].sName,
    Message  := 'Blank name of state 5 falls back to TARGET4');
AssertEquals_STRING(
    Expected := 'SPARE8',
    Actual   := astPositionState[1][9].sName,
    Message  := 'Caller-supplied name of state 9');

TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestTempFFO" Id="{c9f0d310-afe3-4af2-85a2-07d0d6c96a5c}">
      <Declaration><![CDATA[(* The thermocouple faults in every state except OUT.
   Parasitically depends on the state move test. *)
METHOD TestTempFFO
VAR_INST
    tonTimer    : TON;
    nStep       : UINT := 0;
    bOutChecked : BOOL := FALSE;
    bInChecked  : BOOL := FALSE;
END_VAR
VAR CONSTANT
    nLastStep : UINT := 3;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestATMGenericTempFFO');

tonTimer(IN := TRUE, PT := T#10s);

CASE nStep OF
    0:
        SetATMTemp(100);
        nStep := nStep + 1;
    1:
        IF eEnumGet = E_ATMGenericTestStates.OUT THEN
            AssertTrue(
                fbATM.fbTempSensor1.FFO.i_xOK,
                'Faulted even in out position!'
            );
            bOutChecked := TRUE;
        ELSIF eEnumGet <> E_ATMGenericTestStates.Unknown THEN
            AssertFalse(
                fbATM.fbTempSensor1.FFO.i_xOK,
                'No fault even for an in position!'
            );
            bInChecked := TRUE;
        END_IF
        IF bOutChecked AND bInChecked THEN
            nStep := nStep + 1;
        END_IF
    2:
        SetATMTemp(0);
        nStep := nStep + 1;
    3:
        AssertTrue(
            fbATM.fbTempSensor1.FFO.i_xOK,
            'Faulted even with low temp!'
        );
        nStep := nStep + 1;
END_CASE

IF tonTimer.Q OR nStep > nLastStep THEN
    AssertFalse(tonTimer.Q, 'Timeout in ATM generic temp FFO test');
    TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
