<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ATM_Generic" Id="{85be6ac4-4a2e-4366-9828-5146d93a7045}" SpecialFunc="None">
    <Declaration><![CDATA[(* Arrival Time Monitor with a caller-owned state enum: FB_ATM_Core plus the
   state bridge, the state count and the state names through FB_Init.

   The integrator declares its own enum (UINT base, OUT = 1, then the targets)
   with the MMS:STATE:SET and MMS:STATE:GET pytmc pragmas on its own variables,
   so the EPICS state menu comes from that enum, and passes the two variables
   in as REFERENCE TO UINT. nStateCount counts OUT plus the targets (0 means 6,
   limited to 2..GeneralConstants.MAX_STATES). asStateName optionally names
   each state; a blank entry falls back to OUT and TARGET1, TARGET2, ...
   FB_ATM is the variant for the library enum E_ATM_States. *)
{attribute 'call_after_init'}
FUNCTION_BLOCK FB_ATM_Generic EXTENDS FB_ATM_Core
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{20b33c50-fddb-4871-8582-356e49b45ef0}">
      <Declaration><![CDATA[(* Forwards the eleven core arguments to FB_ATM_Core, then binds the state
   bridge, the state count and the state names. *)
{attribute 'analysis' := '-33'}
METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains           : BOOL;
    bInCopyCode            : BOOL;
    aiMotionStage          : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS] OF I_MotionStage;
    astPositionState       : REFERENCE TO ARRAY[1..MotionConstants.MAX_STATE_MOTORS]
                                            OF ARRAY[1..GeneralConstants.MAX_STATES] OF ST_PositionState;
    fbFFHWO                : REFERENCE TO FB_HardwareFFOutput;
    fbArbiter              : REFERENCE TO FB_Arbiter;
    sDeviceName            : STRING;
    sTransitionKey         : STRING;
    bEnableBeamParams      : BOOL;
    bEnablePositionLimits  : BOOL;
    bReadDBNow             : BOOL;
    bFileReaderBusy        : REFERENCE TO BOOL;
    bFileReaderError       : REFERENCE TO BOOL;
    eEnumSetRef            : REFERENCE TO UINT;
    eEnumGetRef            : REFERENCE TO UINT;
    nStateCount            : UINT;
    asStateName            : REFERENCE TO ARRAY[1..GeneralConstants.MAX_STATES] OF STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.FB_Init(
    bInitRetains          := bInitRetains,
    bInCopyCode           := bInCopyCode,
    aiMotionStage         := aiMotionStage,
    astPositionState      := astPositionState,
    fbFFHWO               := fbFFHWO,
    fbArbiter             := fbArbiter,
    sDeviceName           := sDeviceName,
    sTransitionKey        := sTransitionKey,
    bEnableBeamParams     := bEnableBeamParams,
    bEnablePositionLimits := bEnablePositionLimits,
    bReadDBNow            := bReadDBNow,
    bFileReaderBusy       := bFileReaderBusy,
    bFileReaderError      := bFileReaderError
);

THIS^.eEnumSetRef REF= eEnumSetRef;
THIS^.eEnumGetRef REF= eEnumGetRef;
THIS^.asStateName REF= asStateName;
THIS^.nStateCount := nStateCount;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
